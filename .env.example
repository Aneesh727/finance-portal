# --- Database (PostgreSQL 14+) ---
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5432/finance_portal?schema=public"

# --- App ---
NODE_ENV="production"
# Public origin of the app. Used for CSRF/Origin checks. No trailing slash.
APP_ORIGIN="https://portal.example.com"
# Set to "true" only when serving over HTTPS (secure cookies). Default: true in production.
COOKIE_SECURE="true"
# Session lifetime in hours (idle sliding window is 12h by default)
SESSION_TTL_HOURS="12"
# 32+ random chars. Used to sign short-lived tokens/idempotency fingerprints.
APP_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
# bcrypt cost factor (12 recommended in production)
BCRYPT_COST="12"

# --- File storage (private, never served statically) ---
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="10"

# --- Seed / first-run ---
# Initial super-admin used by `npm run db:seed` (only when no users exist)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_Strong#Passw0rd"
